# Copy to .env and fill in. .env is git-ignored.
ADDR=:8080
DATABASE_URL=postgres://hooklens:CHANGE_ME@localhost:5432/hooklens?sslmode=disable
# Public base URL of this server (used to build webhook URLs shown to users)
PUBLIC_URL=http://localhost:8080
# Dev only: origin of `next dev` so the browser can call the API with cookies
WEB_ORIGIN=http://localhost:3000
# Directory of the exported dashboard (web/out). Served by the API when present.
STATIC_DIR=web/out
MAX_BODY_BYTES=1048576
RETENTION_DAYS=7
MAX_ENDPOINTS_PER_USER=10
MAX_TUNNELS_PER_USER=5
FORWARD_TIMEOUT_SECONDS=30
# Set true behind a reverse proxy / PaaS (Fly, Render, Cloudflare) to trust X-Forwarded-For
TRUST_PROXY=false
# Set true when served over HTTPS
SECURE_COOKIES=false
ALLOW_SIGNUP=true

# Comma-separated emails allowed to read user feedback at /admin/
ADMIN_EMAILS=
